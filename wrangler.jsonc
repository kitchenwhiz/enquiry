{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enquiry",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Address enquiry.kitchenwhiz.in is attached in the Cloudflare dashboard
  // (enquiry → Domains → Add Domain), not here, so builds never need domain permissions.
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Database for enquiries and team notes. Tables are created automatically on first use.
  // No database_id: Wrangler creates the database on the first deploy and remembers it.
  // If a deploy ever asks for an id, create a D1 database named "enquiry-db" in Cloudflare
  // and paste its id here as "database_id".
  "d1_databases": [
    { "binding": "DB", "database_name": "enquiry-db" }
  ],
  // Automatic WhatsApp confirmation (Gupshup). Fill these in; the API key is NOT here:
  // add it in Cloudflare → Workers & Pages → enquiry → Settings → Variables and Secrets
  // as a Secret named GUPSHUP_API_KEY. Until all four are set, no confirmation is sent.
  "vars": {
    "GUPSHUP_APP_NAME": "KitchenWhiz",
    "GUPSHUP_SOURCE": "918904657979",
    "GUPSHUP_TEMPLATE_ID": "d8d5f96b-224c-4dd5-a872-b4e71d970eba", // template enquiry_confirmation
    // what fills {{1}}, {{2}}… in the template, in order. Template (21 Oct): "Hello! From Kitchen Whiz, thank you for your
    // enquiry with {{1}} for {{2}}. Please call {{3}} for speedy assistance." Choices: name, firstname, ref, brand,
    // products, contact (brand phone numbers, src/brands.js), count, phone, date
    "GUPSHUP_TEMPLATE_PARAMS": "brand,products,contact"
  },
  "observability": { "enabled": true }
}
